---
// Rotating 3D ASCII microphone — the podcast counterpart to <AsciiFlower />.
//
// Same idea and same visual language as the flower (point cloud → extruded
// volume → depth-shaded ASCII in a <pre>), but the silhouette is defined
// MATHEMATICALLY rather than sampled from a PNG: a capsule head, the U-shaped
// yoke, a stem and a base. That keeps it asset-free — nothing to add to R2, and
// the shape stays crisp at any sampling density.
//
// The mark itself is STATIC — a single frame at a fixed 3/4 view, drawn once.
// The only motion is on hover: a ripple that travels out from the pointer and
// pushes each character it passes up the density ramp, so the interaction reads
// in the medium the mark is made of. Nothing animates until you point at it, and
// prefers-reduced-motion skips the ripple entirely.
---

<div class="mic-wrap" data-mic-wrap aria-hidden="true">
  <pre class="mic" data-ascii-mic></pre>
</div>

<style>
  .mic-wrap {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1 / 1;
  }
  .mic {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-ink-text, #ededee);
    white-space: pre;
    line-height: 1;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    text-shadow: 0 0 14px rgba(255, 255, 255, 0.08);
  }
</style>

<script is:inline>
  (() => {
    if (window.__asciiMic) {
      window.__asciiMicInit && window.__asciiMicInit();
      return;
    }
    window.__asciiMic = true;

    const ROWS = 44;
    const COLS = 74; // mono chars are ~0.55 as wide as tall
    const CHAR_ASPECT = 0.55;
    const RAMP = " .:-=+*oc#%@";
    // Drawn face-on and in PARALLEL projection: no rotation, no perspective
    // divide. The extruded depth is kept, but only to shade the mark — thicker
    // through the middle reads denser on the ramp — never to turn it.
    const DEPTH = 0.26; // front-to-back thickness, used for shading only
    const DZ = 0.075; // z fill spacing → one solid volume, no layer banding
    const VIEW_Y = 0;
    const VIEW_X = 0;
    // hover ripple
    const SIG = 5.2; // gaussian falloff radius, in character cells
    const BOOST = 0.85; // how far up the ramp the crest pushes a character
    const WAVE = 0.55; // ring frequency
    const SPEED = 0.13; // ring travel speed
    const DECAY = 0.06; // how fast the ripple fades once the pointer leaves
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /** Microphone silhouette test in normalized coords (x,y ∈ [-1,1], y up). */
    function inMic(x, y) {
      // head: capsule from (0,0.06) to (0,0.66), radius 0.30
      const cy = Math.max(0.06, Math.min(0.66, y));
      if (Math.hypot(x, y - cy) <= 0.3) return true;
      // yoke: the U-shaped bracket hugging the lower half of the head
      const r = Math.hypot(x, y - 0.3);
      if (r >= 0.44 && r <= 0.52 && y <= 0.34) return true;
      // stem
      if (Math.abs(x) <= 0.075 && y >= -0.72 && y <= -0.12) return true;
      // base: a low rounded slab
      if (Math.abs(x) <= 0.4 && y >= -0.86 && y <= -0.72) {
        const ex = Math.max(0, Math.abs(x) - 0.32);
        return Math.hypot(ex, Math.max(0, -0.79 - y) * 2) <= 0.09;
      }
      return false;
    }

    // Geometry is identical for every instance → build the point cloud once.
    const pts = (() => {
      const N = 140; // silhouette sampling resolution
      const raw = [];
      for (let iy = 0; iy < N; iy++) {
        for (let ix = 0; ix < N; ix++) {
          const nx = (ix - N / 2) / (N / 2);
          const ny = -(iy - N / 2) / (N / 2);
          if (inMic(nx, ny)) raw.push([nx, ny]);
        }
      }
      if (!raw.length) return [];
      let maxR = 1e-4;
      for (const p of raw) {
        const r = Math.hypot(p[0], p[1]);
        if (r > maxR) maxR = r;
      }
      const out = [];
      const step = raw.length > 2600 ? Math.ceil(raw.length / 2600) : 1;
      for (let i = 0; i < raw.length; i += step) {
        const [nx, ny] = raw[i];
        const rr = Math.hypot(nx, ny) / maxR;
        const dz = DEPTH * Math.sqrt(Math.max(0, 1 - rr * rr * 0.55));
        if (dz < DZ) {
          out.push([nx, ny, 0]);
        } else {
          for (let z = -dz; z <= dz + 1e-6; z += DZ) out.push([nx, ny, z]);
        }
      }
      return out;
    })();

    /** Draw the one static frame and cache its per-cell shade for the ripple. */
    function build(inst) {
      const size = inst.w.clientWidth || 260;
      const fontPx = size / ROWS;
      inst.pre.style.fontSize = fontPx + "px";
      inst.pre.style.lineHeight = fontPx + "px";

      const shade = new Float32Array(COLS * ROWS).fill(-1); // -1 → empty cell
      const zb = new Float32Array(COLS * ROWS).fill(-Infinity);
      const cy_ = Math.cos(VIEW_Y), sy_ = Math.sin(VIEW_Y);
      const cx_ = Math.cos(VIEW_X), sx_ = Math.sin(VIEW_X);
      const cX = COLS / 2, cY = ROWS / 2;
      const spread = (ROWS / 2) * 0.84;
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        const rx = p[0] * cy_ + p[2] * sy_;
        const rz = -p[0] * sy_ + p[2] * cy_;
        const ty = p[1] * cx_ - rz * sx_;
        const tz = p[1] * sx_ + rz * cx_;
        // orthographic: depth must not scale the silhouette
        const col = Math.round(cX + (rx * spread) / CHAR_ASPECT);
        const row = Math.round(cY - ty * spread);
        if (col < 0 || col >= COLS || row < 0 || row >= ROWS) continue;
        const idx = row * COLS + col;
        if (tz > zb[idx]) {
          zb[idx] = tz;
          shade[idx] = Math.max(0, Math.min(1, 0.18 + (tz / DEPTH) * 0.62));
        }
      }
      inst.shade = shade;
      paint(inst);
    }

    /** Rebuild the text from the cached shades plus the current ripple. Only
     *  cells that are already part of the mark change, so the silhouette holds;
     *  the ripple moves characters along the density ramp, never adds new ones. */
    function paint(inst) {
      const shade = inst.shade;
      if (!shade) return;
      const rippling = inst.amp > 0.003;
      let out = "";
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const v = shade[r * COLS + c];
          if (v < 0) {
            out += " ";
            continue;
          }
          let sh = v;
          if (rippling) {
            const dx = (c - inst.px) * CHAR_ASPECT; // circular in visual space
            const dy = r - inst.py;
            const d = Math.hypot(dx, dy);
            const env = Math.exp(-(d * d) / (2 * SIG * SIG)); // fades with distance
            sh += inst.amp * BOOST * env * Math.cos(d * WAVE - inst.t); // travelling ring
          }
          sh = sh < 0 ? 0 : sh > 1 ? 1 : sh;
          out += RAMP[1 + Math.floor(sh * (RAMP.length - 2))];
        }
        if (r < ROWS - 1) out += "\n";
      }
      inst.pre.textContent = out;
    }

    function tick(inst) {
      if (!inst.pre.isConnected) {
        inst.rafId = null;
        return;
      }
      inst.t += SPEED;
      if (!inst.hover) inst.amp -= DECAY; // pointer gone → settle back to static
      if (!inst.hover && inst.amp <= 0.003) {
        inst.amp = 0;
        paint(inst); // final frame: the plain static mark
        inst.rafId = null;
        return;
      }
      paint(inst);
      inst.rafId = requestAnimationFrame(() => tick(inst));
    }

    function initOne(w) {
      const pre = w.querySelector("[data-ascii-mic]");
      if (!pre || pre.dataset.bound) return;
      pre.dataset.bound = "1";
      const inst = { w, pre, shade: null, amp: 0, px: 0, py: 0, t: 0, hover: false, rafId: null };
      build(inst);
      addEventListener("resize", () => build(inst), { passive: true });
      if (reduce) return; // reduced motion: the static mark, nothing else

      const at = (e) => {
        const b = w.getBoundingClientRect();
        inst.px = ((e.clientX - b.left) / b.width) * COLS;
        inst.py = ((e.clientY - b.top) / b.height) * ROWS;
      };
      const wake = () => {
        if (!inst.rafId) inst.rafId = requestAnimationFrame(() => tick(inst));
      };
      w.addEventListener("pointerenter", (e) => {
        at(e);
        inst.hover = true;
        inst.amp = 1;
        wake();
      });
      w.addEventListener("pointermove", (e) => {
        at(e);
        if (inst.hover) {
          inst.amp = 1;
          wake();
        }
      });
      w.addEventListener("pointerleave", () => {
        inst.hover = false;
      });
    }

    const init = () => document.querySelectorAll("[data-mic-wrap]").forEach(initOne);
    window.__asciiMicInit = init;
    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>
