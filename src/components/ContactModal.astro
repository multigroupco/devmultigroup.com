---
// Every "contact us" button on the site ([data-contact="support|partner|sponsor"])
// opens a plain e-mail to support. The site has no contact form and no newsletter:
// it sends no mail and stores nothing about the visitor.
import { BRAND } from "@/lib/site";
const SUBJECTS = { support: "Developer MultiGroup", partner: "İş birliği", sponsor: "Sponsorluk" };
---

<script is:inline define:vars={{ email: BRAND.email, subjects: SUBJECTS }}>
  if (!window.__dmgContact) {
    window.__dmgContact = true;
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-contact]");
      if (!trigger) return;
      e.preventDefault();
      const subject = subjects[trigger.getAttribute("data-contact")] || subjects.support;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
    });
  }
</script>
