---
// Page-transition loading screen: a spinning flower mark + a thin top progress
// bar. Driven by Astro's view-transition lifecycle (astro:before-preparation →
// astro:page-load). Marked transition:persist so the element survives the swap.
---

<div id="dmg-loader" class="dmg-loader" transition:persist="dmg-loader" role="status" aria-hidden="true">
  <div class="dmg-loader-bar"><span></span></div>
  <img src="/logo-small-white.png" alt="" width="44" height="44" class="dmg-loader-logo" />
</div>

<style>
  .dmg-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    /* NO backdrop-filter here. The backdrop is <SiteBackground>, which is
       transition:persist'd and holds three animating filter:blur(100px) blobs
       plus a mix-blend-mode grain layer. Blurring *that* forced a full-screen
       re-rasterisation every frame the loader was up — the background flashing
       and staggering during navigation. On a near-black surface the blur bought
       nothing anyway, so an almost-opaque fill replaces it. */
    background: rgba(0, 0, 0, 0.94);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-out-soft), visibility 0.3s var(--ease-out-soft);
  }
  .dmg-loader.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .dmg-loader-logo {
    width: 44px;
    height: 44px;
    animation: dmg-loader-spin 0.9s linear infinite;
  }
  @keyframes dmg-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .dmg-loader-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .dmg-loader-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    transition: width 0.2s var(--ease-out-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .dmg-loader-logo {
      animation: none;
    }
    .dmg-loader,
    .dmg-loader-bar span {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const setup = () => {
      const loader = document.getElementById("dmg-loader");
      if (!loader) return;
      const bar = loader.querySelector(".dmg-loader-bar span");
      let trickle, showT, hideT, prog = 0, shownAt = 0;
      const set = (p) => {
        prog = p;
        if (bar) bar.style.width = p + "%";
      };

      // Only genuinely slow navigations deserve an overlay, and once it IS up it
      // has to stay long enough to read as deliberate.
      //
      // The previous 280ms/90ms pair was the worst of both: with
      // prefetch.prefetchAll + viewport strategy most navigations land in the
      // 200-500ms band, so the overlay kept appearing just long enough to start
      // its 300ms fade and then be torn down ~110ms later — a half-drawn flash
      // on some navigations and nothing on others. Inconsistent flashing is what
      // read as stutter.
      const SHOW_DELAY = 600; // don't show at all below this
      const MIN_VISIBLE = 450; // once shown, never yank it away faster than this

      const start = () => {
        clearTimeout(hideT);
        clearTimeout(showT);
        showT = setTimeout(() => {
          shownAt = performance.now();
          loader.classList.add("is-active");
          // Park the background blob animation while the overlay is up — one
          // less thing compositing behind a full-screen fixed layer.
          document.documentElement.classList.add("is-navigating");
          set(12);
          clearInterval(trickle);
          trickle = setInterval(() => set(prog + (90 - prog) * 0.12), 220);
        }, SHOW_DELAY);
      };

      const done = () => {
        clearTimeout(showT);
        clearInterval(trickle);
        document.documentElement.classList.remove("is-navigating");
        if (!loader.classList.contains("is-active")) {
          // The common path now: the navigation beat SHOW_DELAY, so nothing was
          // ever painted and there is nothing to tear down.
          set(0);
          return;
        }
        set(100);
        hideT = setTimeout(
          () => {
            loader.classList.remove("is-active");
            setTimeout(() => set(0), 320);
          },
          Math.max(0, MIN_VISIBLE - (performance.now() - shownAt)),
        );
      };

      document.addEventListener("astro:before-preparation", start);
      document.addEventListener("astro:page-load", done);
    };

    if (!window.__dmgLoader) {
      window.__dmgLoader = true;
      setup();
    }
  })();
</script>
