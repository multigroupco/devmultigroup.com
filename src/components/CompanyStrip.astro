---
// Scrolling logo marquee. The line-up is admin-managed: every company ticked
// "Ana sayfa logo şeridi" on /admin/companies shows up here (falling back to the
// featured set, then to the static COMPANIES list if D1 is unreachable).
import { COMPANIES } from "@/lib/site";
import { tryEnv } from "@/lib/runtime";
import { listStripCompanies } from "@/lib/content";
import { imageSrc } from "@/lib/ui";

interface Props {
  reverse?: boolean;
}
const { reverse = false } = Astro.props;

const env = tryEnv(Astro.locals);
let brands: { name: string; logo: string }[] = [];
if (env) {
  try {
    brands = (await listStripCompanies(env)).map((c) => ({
      name: c.name,
      logo: imageSrc(c.logo_url),
    }));
  } catch {
    /* pre-seed / DB down → static fallback below */
  }
}
if (!brands.length) brands = [...COMPANIES];

const logos = [...brands, ...brands];
---

{
  logos.length > 0 && (
    <div class="overflow-hidden mask-fade-x">
      <div
        class:list={[
          "marquee-track flex items-center gap-12 md:gap-16 w-max py-2 hover:[animation-play-state:paused]",
          reverse ? "animate-marquee-rev" : "animate-marquee",
        ]}
      >
        {logos.map((c) => (
          /* The track animates to translateX(-50%), so its width must be final
             BEFORE the first frame. `w-auto` + `loading="lazy"` made each cell
             resize as it decoded, moving the -50% target mid-animation — the
             stagger. Every cell now reserves a fixed box and loads eagerly. */
          <img
            src={c.logo}
            alt={c.name}
            width="120"
            height="32"
            loading="eager"
            decoding="async"
            fetchpriority="low"
            class="h-7 md:h-8 w-[104px] md:w-[120px] object-contain opacity-50 hover:opacity-100 transition-opacity shrink-0"
          />
        ))}
      </div>
    </div>
  )
}

<style>
  /* Promote the track to its own compositor layer so the marquee never repaints
     the logo row frame-by-frame. */
  .marquee-track {
    will-change: transform;
    backface-visibility: hidden;
  }
</style>
