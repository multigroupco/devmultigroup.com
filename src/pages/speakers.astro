---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { tryEnv } from "@/lib/runtime";
import { listSpeakers, listCompanies } from "@/lib/content";
import { imageSrc } from "@/lib/ui";
import { BRAND } from "@/lib/site";
import type { SpeakerRow, CompanyRow, SpeakerSocials } from "@/lib/types";

const env = tryEnv(Astro.locals);
let speakers: SpeakerRow[] = [];
let companies: CompanyRow[] = [];
if (env) {
  try {
    [speakers, companies] = await Promise.all([listSpeakers(env, { limit: 1000 }), listCompanies(env)]);
  } catch {
    /* pre-seed */
  }
}
const byId = new Map(companies.map((c) => [c.id, c]));
const co = (s: SpeakerRow) => (s.company_id ? byId.get(s.company_id) : null);

const companyCount = new Set(speakers.map((s) => s.company_id).filter(Boolean)).size;

const sectors = [
  ...new Set(speakers.map((s) => co(s)?.sector).filter((x): x is string => Boolean(x))),
].sort((a, b) => a.localeCompare(b, "tr"));

const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
const parseSoc = (raw: string): SpeakerSocials => {
  try { return raw ? JSON.parse(raw) : {}; } catch { return {}; }
};
const socList = (s: SpeakerRow) => {
  const x = parseSoc(s.socials);
  return ([["linkedin", x.linkedin], ["github", x.github], ["twitter", x.twitter], ["globe", x.website]] as const)
    .filter((p): p is [(typeof p)[0], string] => Boolean(p[1]));
};

// prestige ranking — global brands + senior/expert titles + prolific speakers
// float to the top of the roster (and drive the featured marquee).
const GLOBAL_CO =
  /\b(google|alphabet|meta|facebook|instagram|whatsapp|amazon|aws|microsoft|apple|netflix|nvidia|intel|ibm|oracle|sap|salesforce|adobe|atlassian|stripe|shopify|spotify|uber|instacart|booking|linkedin|tiktok|bytedance|snap|huawei|samsung|jetbrains|github|gitlab|canva|revolut|klarna|zalando|delivery hero|trendyol|getir|hepsiburada|peak games|dream games|adesso)\b/i;
const EXPERT_TITLE = /(google developer expert|\bgde\b|microsoft mvp|\bresearch)/i;
const SENIOR_TITLE =
  /(\bstaff\b|principal|distinguished|\barchitect\b|\blead\b|\bhead\b|director|\bvp\b|founder|co-?founder|\bcto\b|\bceo\b|chief|\bsenior\b|\bsr\.?\b)/i;

const prestige = (s: SpeakerRow) => {
  const c = co(s);
  const hay = `${s.company || ""} ${c?.name || ""}`;
  const title = s.title || "";
  let score = 0;
  if (GLOBAL_CO.test(hay)) score += 100;
  if (EXPERT_TITLE.test(title)) score += 55;
  if (SENIOR_TITLE.test(title)) score += 35;
  score += Math.min(s.talk_count || 0, 25) * 3;
  if (s.avatar_url) score += 6;
  if (s.title) score += 4;
  return score;
};
const rank = (a: SpeakerRow, b: SpeakerRow) =>
  prestige(b) - prestige(a) || (b.talk_count || 0) - (a.talk_count || 0) || a.name.localeCompare(b.name, "tr");

// roster: high-level / global names first
const roster = [...speakers].sort(rank);
// featured marquee: top-ranked speakers that have a photo + a title (modest count)
const featured = speakers.filter((s) => s.avatar_url && s.title).sort(rank).slice(0, 10);

const speakersLd = speakers.length
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Developer MultiGroup konuşmacıları",
      numberOfItems: speakers.length,
      itemListElement: speakers.slice(0, 100).map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@type": "Person", name: s.name, ...(s.title ? { jobTitle: s.title } : {}), ...(s.company ? { worksFor: { "@type": "Organization", name: s.company } } : {}) },
      })),
    }
  : undefined;
---

<BaseLayout
  title="Konuşmacılar"
  description="6 yılda Developer MultiGroup sahnesinde yer alan konuşmacılar: mühendisler, takım liderleri, kurucular ve araştırmacılar. Yüzlerce talk, tek bir topluluk."
  canonicalPath="/speakers"
  jsonLd={speakersLd}
  breadcrumbs={[{ name: "Konuşmacılar", item: `${BRAND.url}/speakers` }]}
>
  <!-- hero -->
  <section class="sp-stage relative isolate overflow-hidden">
    {/* Hand-rolled spotlight: one big ellipse, rotated off-axis and heavily
        blurred, sweeping in from the top-right so the light lands on the
        metrics. Same construction as the Aceternity component (blurred rotated
        ellipse in an SVG filter) but written here rather than imported. */}
    <svg class="sp-spot" viewBox="0 0 3787 2842" fill="none" aria-hidden="true" preserveAspectRatio="none">
      <g filter="url(#sp-blur)">
        <ellipse
          cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
          transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
          fill="white" fill-opacity="0.34"></ellipse>
      </g>
      <defs>
        <filter id="sp-blur" x="0.860352" y="0.838989" width="3785.16" height="2840.26"
          filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"></feBlend>
          <feGaussianBlur stdDeviation="151" result="effect1_foregroundBlur"></feGaussianBlur>
        </filter>
      </defs>
    </svg>
    <div class="container-x pt-14 pb-7">
    <div class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-16 lg:items-end">
      <h1 class="text-4xl md:text-6xl font-semibold leading-[1.02] max-w-3xl">
        Sahnemizin <span class="text-grad">ışığı olan</span> konuşmacılarımız
      </h1>
      <dl class="sp-metrics shrink-0">
        <div class="sp-metric"><dt>{speakers.length}</dt><dd>konuşmacı</dd></div>
        <div class="sp-metric"><dt>{sectors.length}</dt><dd>sektör</dd></div>
        <div class="sp-metric"><dt>{companyCount}</dt><dd>şirket</dd></div>
      </dl>
    </div>
    <p class="text-ink-dim mt-6 max-w-2xl leading-relaxed">
      İlk günden bugüne bilgisini ve deneyimini topluluğumuzla paylaşan herkes. Hepsine
      teşekkür ederiz, bu sahne onların.
    </p>
    </div>
  </section>

  {
    featured.length >= 6 && (
      <section class="container-x pb-3">
        <h2 class="text-[0.7rem] font-mono uppercase tracking-[0.18em] text-ink-faint mb-4">Öne çıkanlar</h2>
        {/* auto-scrolling marquee; edges fade (mask-fade-x) instead of hard-cropping */}
        <div class="sp-marquee overflow-hidden mask-fade-x -mx-1">
          <div class="sp-track flex gap-3 w-max animate-marquee py-1 px-1">
            {[...featured, ...featured].map((s, i) => {
              const c = co(s);
              // flex column + a two-line title well + mt-auto footer: titles are
              // line-clamp-2, so they render as 1 OR 2 lines, which used to push
              // the company row to a different height on every card.
              return (
                <div class="shrink-0 w-60 card p-4 flex flex-col" aria-hidden={i >= featured.length ? "true" : undefined}>
                  <div class="relative w-14 h-14 rounded-full overflow-hidden bg-white/[0.05] border border-line mb-3 skeleton shrink-0">
                    <img src={imageSrc(s.avatar_url)} alt={s.name} loading="lazy" decoding="async" class="img-reveal absolute inset-0 w-full h-full object-cover" />
                  </div>
                  <h3 class="font-medium leading-snug truncate">{s.name}</h3>
                  <p class="text-ink-dim text-xs mt-1 leading-snug line-clamp-2 min-h-[2.1rem]">{s.title}</p>
                  <div class="mt-auto pt-2.5 flex items-center gap-2 h-4 box-content">
                    {c?.logo_url ? <img src={imageSrc(c.logo_url)} alt={c.name} class="h-3.5 w-auto max-w-[80px] object-contain opacity-70" loading="lazy" /> : <span class="text-ink-faint text-xs truncate">{s.company}</span>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- toolbar -->
  <section class="container-x pt-5">
    <div class="flex flex-col gap-4 scroll-mt-20">
      <label class="relative max-w-md">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-faint pointer-events-none"><Icon name="search" size={16} /></span>
        <input id="sp-search" type="text" autocomplete="off" placeholder="Konuşmacı veya şirket ara…"
          class="w-full bg-white/[0.04] border border-line rounded-xl pl-9 pr-9 py-2.5 text-sm placeholder:text-ink-faint focus:outline-none focus:border-white/25 transition" />
        <button type="button" id="sp-search-clear" aria-label="Temizle" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-faint hover:text-ink-text"><Icon name="close" size={15} /></button>
      </label>
      <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 no-scrollbar edge-fade-r">
        <button type="button" class="sector-pill is-active" data-sector="">Tümü <span class="tabular-nums opacity-60">{speakers.length}</span></button>
        {sectors.map((s) => <button type="button" class="sector-pill" data-sector={s}>{s}</button>)}
      </div>
    </div>
  </section>

  <!-- roster index -->
  <section class="container-x py-6">
    <ol id="sp-roster" class="border-t border-line">
      {
        roster.map((s) => {
          const c = co(s);
          const socs = socList(s);
          return (
            <li class="sp-row group grid grid-cols-[auto_1fr] sm:grid-cols-[auto_minmax(0,1fr)_13rem] md:grid-cols-[auto_minmax(0,1fr)_13rem_7rem] items-center gap-x-4 gap-y-1 py-3 border-b border-line-soft hover:bg-white/[0.02] transition-colors scroll-mt-24"
              id={`s-${s.id}`} data-q={`${s.name} ${s.company} ${s.title}`.toLocaleLowerCase("tr")} data-sector={c?.sector ?? ""}>
              <div class:list={["relative w-10 h-10 rounded-full overflow-hidden bg-white/[0.05] border border-line grid place-items-center shrink-0", s.avatar_url && "skeleton"]}>
                {s.avatar_url ? <img src={imageSrc(s.avatar_url)} alt={s.name} loading="lazy" decoding="async" class="img-reveal absolute inset-0 w-full h-full object-cover" /> : <span class="font-display text-xs text-ink-dim">{initials(s.name)}</span>}
              </div>
              <div class="min-w-0">
                <h3 class="font-medium leading-tight truncate">{s.name}</h3>
                {s.title && <p class="text-ink-faint text-xs mt-0.5 truncate">{s.title}</p>}
              </div>
              {/* company — fixed-width column, centered so every logo sits on one axis */}
              <div class="hidden sm:flex items-center justify-center min-w-0">
                {c?.logo_url ? <img src={imageSrc(c.logo_url)} alt={c.name} loading="lazy" class="h-4 w-auto max-w-[120px] object-contain opacity-70" /> : <span class="text-ink-dim text-sm truncate">{s.company}</span>}
              </div>
              {/* socials — fixed-width column (hover-revealed) so it never shifts the logo column */}
              <div class="hidden md:flex items-center justify-end gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
                {socs.map(([icon, url]) => (
                  <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} · ${icon}`} class="grid place-items-center w-7 h-7 rounded-lg text-ink-faint hover:text-ink-text hover:bg-white/[0.06] transition"
                    data-track="cta_click" data-track-props={JSON.stringify({ cta_id: `speaker_social_${icon}`, name: s.name, page: "speakers" })}>
                    <Icon name={icon} size={14} />
                  </a>
                ))}
              </div>
            </li>
          );
        })
      }
    </ol>
    <p id="sp-empty" class="hidden text-center text-ink-faint text-sm py-12">
      Eşleşen konuşmacı yok. <button type="button" data-clear-all class="underline hover:text-ink-text">Temizle</button>
    </p>
  </section>

  <style>
    /* ── spotlight ──────────────────────────────────────────────────────────
       The beam itself lives in the SVG above; this only places and animates it.
       It starts off-frame and drifts in once, rather than looping — a looping
       spotlight reads as a loading state. */
    /* The beam is aimed at a two-column hero. On mobile the layout stacks, so
       it has nothing to land on and just smears a grey diagonal across the
       title — hide it there and light the corner softly instead. */
    .sp-spot { display: none; }
    .sp-stage::before {
      content: "";
      position: absolute;
      inset: -30% -20% auto auto;
      width: 90%;
      height: 70%;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(
        closest-side,
        rgba(255, 255, 255, 0.13),
        rgba(255, 255, 255, 0.04) 55%,
        transparent 78%
      );
    }
    @media (min-width: 1024px) {
      .sp-stage::before { display: none; }
      .sp-spot { display: block; }
    }
    .sp-spot {
      position: absolute;
      /* Pulled up and in so the bright part of the beam lands on the metrics.
         It used to span the full hero and get guillotined at the section edge,
         right above the speaker marquee. */
      top: -62%;
      right: -12%;
      width: 88%;
      height: 168%;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      animation: sp-spot-in 2.2s var(--ease-out-soft) 0.15s forwards;
      /* Dissolve well before the section boundary. With the light already gone
         by then, the container's clip has nothing left to cut — continuity
         without letting the glow spill onto the cards below. */
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 48%,
        rgba(0, 0, 0, 0.55) 72%,
        transparent 92%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 48%,
        rgba(0, 0, 0, 0.55) 72%,
        transparent 92%
      );
    }
    @keyframes sp-spot-in {
      from { opacity: 0; transform: translate(6%, -6%) scale(1.06); }
      to { opacity: 1; transform: none; }
    }

    /* ── hero metrics ─────────────────────────────────────────────────────── */
    .sp-metrics {
      display: flex;
      gap: clamp(1.6rem, 5vw, 3rem);
    }
    .sp-metric dt {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 4vw, 2.5rem);
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(180deg, #fff 40%, rgba(255, 255, 255, 0.6));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .sp-metric dd {
      margin-top: 0.45rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-ink-faint);
    }
    @media (prefers-reduced-motion: reduce) {
      .sp-spot { animation: none; opacity: 1; }
    }

    .sp-row.is-hidden { display: none; }
    .sector-pill { flex: none; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.8rem; border-radius: 999px; font-size: 0.8rem; white-space: nowrap; color: var(--color-ink-dim); border: 1px solid var(--color-line); background: rgba(255,255,255,0.02); transition: all 0.15s var(--ease-out-soft); cursor: pointer; }
    .sector-pill:hover { color: var(--color-ink-text); border-color: rgba(255,255,255,0.2); }
    .sector-pill.is-active { color: #000; background: #fff; border-color: #fff; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { scrollbar-width: none; }
    /* right-only fade for the (left-anchored) sector chip row — soft crop, not flat */
    .edge-fade-r {
      -webkit-mask-image: linear-gradient(to right, #000 88%, transparent);
      mask-image: linear-gradient(to right, #000 88%, transparent);
    }
    /* featured marquee: pause on hover, respect reduced-motion */
    .sp-marquee:hover .sp-track { animation-play-state: paused; }
    @media (prefers-reduced-motion: reduce) { .sp-track { animation: none; } }
  </style>

  <script is:inline>
    (() => {
      const init = () => {
        const roster = document.getElementById("sp-roster");
        const search = document.getElementById("sp-search");
        if (!roster || !search || roster.dataset.bound) return;
        roster.dataset.bound = "1";
        const rows = Array.from(roster.querySelectorAll(".sp-row"));
        const pills = Array.from(document.querySelectorAll(".sector-pill"));
        const clearBtn = document.getElementById("sp-search-clear");
        const empty = document.getElementById("sp-empty");
        const state = { sector: "", q: "" };
        const norm = (s) => (s || "").toLocaleLowerCase("tr").trim();
        const apply = () => {
          let total = 0;
          rows.forEach((r) => {
            const ok = (!state.sector || r.dataset.sector === state.sector) && (!state.q || (r.dataset.q || "").includes(state.q));
            r.classList.toggle("is-hidden", !ok); if (ok) total++;
          });
          if (empty) empty.classList.toggle("hidden", total !== 0);
          if (clearBtn) clearBtn.classList.toggle("hidden", !search.value);
        };
        let deb;
        search.addEventListener("input", () => {
          state.q = norm(search.value); apply();
          clearTimeout(deb);
          deb = setTimeout(() => { const q = state.q.trim(); if (q.length < 2) return; try { window.track && window.track("search_submit", { query: q, result_count: roster.querySelectorAll(".sp-row:not(.is-hidden)").length, surface: "speakers" }); } catch (e) {} }, 400);
        });
        if (clearBtn) clearBtn.addEventListener("click", () => { search.value = ""; state.q = ""; apply(); search.focus(); });
        pills.forEach((p) => p.addEventListener("click", () => { pills.forEach((x) => x.classList.remove("is-active")); p.classList.add("is-active"); state.sector = p.dataset.sector || ""; apply(); }));
        const clearAll = document.querySelector("[data-clear-all]");
        if (clearAll) clearAll.addEventListener("click", () => { state.sector = ""; state.q = ""; search.value = ""; pills.forEach((x) => x.classList.toggle("is-active", !x.dataset.sector)); apply(); });
        apply();
      };
      if (!window.__dmgSpRoster) { window.__dmgSpRoster = true; document.addEventListener("astro:page-load", init); }
      init();
    })();
  </script>
</BaseLayout>
