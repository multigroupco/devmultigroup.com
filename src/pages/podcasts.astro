---
// /podcasts — zero-state while the podcast is being built.
//
// Deliberately a placeholder: no episode list, no feed, no CMS entity yet.
// Same "ascii-mark centrepiece" direction as the store zero-state, with the
// rotating ASCII microphone in place of the flower. Everything else stays
// restrained so this page needs no maintenance until there are real episodes.
import BaseLayout from "@/layouts/BaseLayout.astro";
import AsciiMic from "@/components/AsciiMic.astro";
import Icon from "@/components/Icon.astro";
import { BRAND, SOCIALS } from "@/lib/site";
---

<BaseLayout
  title="Podcast'ler"
  description="Developer MultiGroup podcast'i hazırlanıyor — topluluktan sohbetler, konuk anlatımları ve etkinlik kayıtları."
  canonicalPath="/podcasts"
>
  <section class="pod-soon container-x">
    <div class="soon-inner">
      <div class="mic-stage animate-rise">
        <AsciiMic />
      </div>

      <p class="soon-eyebrow font-mono animate-rise" style="animation-delay: 80ms">PODCAST</p>

      <h1 class="soon-head animate-rise" style="animation-delay: 140ms">
        <span class="text-grad">Çok</span> yakında
      </h1>

      <p class="soon-sub animate-rise" style="animation-delay: 210ms">
        Topluluktan sohbetler, konuk anlatımları ve sahne arkası — mikrofonu kuruyoruz.
      </p>

      <div class="soon-actions animate-rise" style="animation-delay: 280ms">
        <a href="/recordings" class="btn btn-primary" data-track="cta_click" data-track-props={JSON.stringify({ cta_id: "podcasts_recordings", page: "podcasts" })}>
          Kayıtlara göz at
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="soon-foot animate-rise" style="animation-delay: 360ms">
        <p class="soon-motto font-mono">{BRAND.tagline}</p>
        <a
          href={SOCIALS.multigroup.youtube}
          target="_blank"
          rel="me noopener noreferrer"
          class="soon-yt"
          aria-label="Developer MultiGroup YouTube"
          title="Developer MultiGroup YouTube"
        >
          <Icon name="youtube" size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pod-soon {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding-block: 5rem 6rem;
  }
  @media (min-width: 768px) {
    .pod-soon {
      padding-block: 7rem;
    }
  }
  .soon-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .mic-stage {
    position: relative;
    width: clamp(12rem, 40vw, 17rem);
  }
  .mic-stage::before {
    content: "";
    position: absolute;
    inset: -14%;
    z-index: -1;
    background: radial-gradient(circle at 50% 47%, rgba(255, 255, 255, 0.06), transparent 68%);
    pointer-events: none;
  }
  .mic-stage :global(.mic-wrap) {
    margin-inline: auto;
  }
  .soon-eyebrow {
    margin-top: 2.3rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--color-ink-faint);
  }
  .soon-head {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin-top: 0.9rem;
  }
  .soon-sub {
    margin-top: 1.1rem;
    max-width: 32rem;
    color: var(--color-ink-dim);
    line-height: 1.7;
  }
  .soon-actions {
    margin-top: 2.2rem;
  }
  .soon-foot {
    margin-top: 3.4rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .soon-motto {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .soon-yt {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    color: var(--color-ink-dim);
    transition: color 0.2s, border-color 0.2s;
  }
  .soon-yt:hover {
    color: var(--color-ink-text);
    border-color: var(--color-line-strong);
  }
</style>
