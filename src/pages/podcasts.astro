---
// /podcasts — the shows we make.
//
// Two states in one file. With no rows it stays the zero-state it has always
// been (the rotating ASCII microphone, "çok yakında"); the moment a show is
// added in /admin/podcasts it becomes an index. Keeping the placeholder means
// emptying the table can never leave a blank page behind.
import BaseLayout from "@/layouts/BaseLayout.astro";
import AsciiMic from "@/components/AsciiMic.astro";
import PodcastCard from "@/components/PodcastCard.astro";
import Icon from "@/components/Icon.astro";
import { getEnv } from "@/lib/runtime";
import { listPodcasts } from "@/lib/content";
import { BRAND, SOCIALS } from "@/lib/site";
import { imageSrc } from "@/lib/ui";

const env = getEnv(Astro.locals);
let pods = [] as Awaited<ReturnType<typeof listPodcasts>>;
try {
  pods = await listPodcasts(env);
} catch {
  /* table not migrated yet → fall through to the zero-state */
}

const hero = pods[0] ?? null;
const heroCover = hero ? imageSrc(hero.cover_image) : "";

const ld =
  pods.length > 0
    ? pods.map((p) => ({
        "@context": "https://schema.org",
        "@type": "PodcastSeries",
        name: [p.show_name, p.title].filter(Boolean).join(" — "),
        description: p.lede,
        url: `${BRAND.url}/podcasts/${p.slug}`,
        inLanguage: "tr-TR",
        ...(p.host ? { author: { "@type": "Person", name: p.host } } : {}),
      }))
    : undefined;
---

<BaseLayout
  title="Podcast'ler"
  description={
    hero
      ? `${[hero.show_name, hero.title].filter(Boolean).join(" — ")}: ${hero.lede}`
      : "Developer MultiGroup podcast'i hazırlanıyor: topluluktan sohbetler, konuk anlatımları ve etkinlik kayıtları."
  }
  canonicalPath="/podcasts"
  image={heroCover ? (heroCover.startsWith("http") ? heroCover : BRAND.url + heroCover) : undefined}
  jsonLd={ld}
  breadcrumbs={pods.length > 0 ? [{ name: "Podcast'ler", item: `${BRAND.url}/podcasts` }] : undefined}
>
  {
    pods.length > 0 ? (
      <>
        {/* ── hero ─────────────────────────────────────────────────────── */}
        <section class="container-x pt-14 pb-10 md:pt-20">
          <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-10 lg:gap-14 items-center">
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.4em] text-ink-faint animate-rise">
                PODCAST
              </p>
              <h1 class="text-4xl md:text-5xl font-semibold leading-[1.06] mt-5 animate-rise" style="animation-delay: 70ms">
                Kulaklığını tak, <span class="text-grad">hikâyeyi dinle.</span>
              </h1>
              <p class="text-ink-dim text-lg mt-5 max-w-lg leading-relaxed animate-rise" style="animation-delay: 140ms">
                Kariyer hikâyeleri, işin gerçek hali ve dışarıdan görünmeyen tarafı.
                Topluluğun mikrofonu açık — her seride başka bir sohbet.
              </p>
              <div class="flex flex-wrap items-center gap-3 mt-8 animate-rise" style="animation-delay: 210ms">
                <a
                  href={SOCIALS.multigroup.youtube}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                  data-track="cta_click"
                  data-track-props={JSON.stringify({ cta_id: "podcasts_youtube", page: "podcasts", href: SOCIALS.multigroup.youtube })}
                >
                  <Icon name="youtube" size={17} /> YouTube kanalı
                </a>
                <a
                  href="/recordings"
                  class="btn btn-ghost"
                  data-track="cta_click"
                  data-track-props={JSON.stringify({ cta_id: "podcasts_recordings", page: "podcasts" })}
                >
                  Kayıtlara göz at <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>

            <div class="hidden lg:block justify-self-end">
              <AsciiMic />
            </div>
          </div>
        </section>

        {/* ── the shows ────────────────────────────────────────────────── */}
        <section class="container-x pb-20">
          <h2 class="text-sm text-ink-faint uppercase tracking-[0.18em] border-t border-line pt-8 mb-6">
            Seriler
          </h2>
          <div class="flex flex-col gap-6">
            {pods.map((p) => <PodcastCard pod={p} page="podcasts" />)}
          </div>

          <p class="text-ink-faint text-sm mt-10 max-w-xl leading-relaxed">
            Bir seride konuk olmak ya da kendi serini kurmak ister misin?{" "}
            <a href="/contact" class="text-ink-text underline underline-offset-4 decoration-line-strong hover:decoration-current">
              Bize yaz
            </a>{" "}
            — mikrofon topluluğun.
          </p>
        </section>
      </>
    ) : (
      <section class="pod-soon container-x">
        <div class="soon-inner">
          <div class="mic-stage animate-rise">
            <AsciiMic />
          </div>

          <p class="soon-eyebrow font-mono animate-rise" style="animation-delay: 80ms">PODCAST</p>

          <h1 class="soon-head animate-rise" style="animation-delay: 140ms">
            <span class="text-grad">Çok</span> yakında
          </h1>

          <p class="soon-sub animate-rise" style="animation-delay: 210ms">
            Topluluktan sohbetler, konuk anlatımları ve sahne arkası. Mikrofonu kuruyoruz.
          </p>

          <div class="soon-actions animate-rise" style="animation-delay: 280ms">
            <a href="/recordings" class="btn btn-primary" data-track="cta_click" data-track-props={JSON.stringify({ cta_id: "podcasts_recordings", page: "podcasts" })}>
              Kayıtlara göz at
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <div class="soon-foot animate-rise" style="animation-delay: 360ms">
            <p class="soon-motto font-mono">{BRAND.tagline}</p>
            <a
              href={SOCIALS.multigroup.youtube}
              target="_blank"
              rel="me noopener noreferrer"
              class="soon-yt"
              aria-label="Developer MultiGroup YouTube"
              title="Developer MultiGroup YouTube"
            >
              <Icon name="youtube" size={16} />
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .pod-soon {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding-block: 5rem 6rem;
  }
  @media (min-width: 768px) {
    .pod-soon {
      padding-block: 7rem;
    }
  }
  .soon-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .mic-stage {
    position: relative;
    width: clamp(12rem, 40vw, 17rem);
  }
  .mic-stage::before {
    content: "";
    position: absolute;
    inset: -14%;
    z-index: -1;
    background: radial-gradient(circle at 50% 47%, rgba(255, 255, 255, 0.06), transparent 68%);
    pointer-events: none;
  }
  .mic-stage :global(.mic-wrap) {
    margin-inline: auto;
  }
  .soon-eyebrow {
    margin-top: 2.3rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--color-ink-faint);
  }
  .soon-head {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin-top: 0.9rem;
  }
  .soon-sub {
    margin-top: 1.1rem;
    max-width: 32rem;
    color: var(--color-ink-dim);
    line-height: 1.7;
  }
  .soon-actions {
    margin-top: 2.2rem;
  }
  .soon-foot {
    margin-top: 3.4rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .soon-motto {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .soon-yt {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    color: var(--color-ink-dim);
    transition: color 0.2s, border-color 0.2s;
  }
  .soon-yt:hover {
    color: var(--color-ink-text);
    border-color: var(--color-line-strong);
  }
</style>
